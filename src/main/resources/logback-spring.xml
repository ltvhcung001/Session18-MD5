<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Định nghĩa mẫu log in ra Console có chứa %X{requestId} từ MDC (HW2) -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %magenta([%X{requestId:-SYSTEM}]) %highlight(%-5level) %cyan(%logger{36}) - %msg%n"/>

    <!-- Định nghĩa mẫu log thuần cho file (dùng cho Filebeat / Logstash / Kibana ingest) -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{requestId:-SYSTEM}] %-5level %logger{36} - %msg%n"/>

    <!-- 1. Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 2. [HW4] RollingFileAppender: Khắc phục sự cố ổ cứng đầy (40GB) do FileAppender -->
    <!-- Cấu hình xoay vòng theo ngày và kích thước mỗi file 10MB, lưu tối đa 30 ngày -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- File log hiện hành đang được ghi -->
        <file>logs/application.log</file>
        
        <!-- Chính sách xoay vòng kết hợp theo ngày và kích thước (SizeAndTimeBasedRollingPolicy) -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Mẫu tên file sau khi xoay vòng: application-2026-09-28.0.log, application-2026-09-28.1.log -->
            <fileNamePattern>logs/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            
            <!-- Giới hạn kích thước mỗi file là 10MB theo yêu cầu đề bài -->
            <maxFileSize>10MB</maxFileSize>
            
            <!-- Lưu trữ tối đa 30 ngày theo yêu cầu đề bài (file quá 30 ngày tự động bị xóa) -->
            <maxHistory>30</maxHistory>
            
            <!-- Trần dung lượng tổng cộng toàn bộ log lưu trữ (3GB) nhằm bảo vệ triệt để ổ cứng VPS -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 3. [HW3] Custom Discord Appender: Bắn cảnh báo ERROR lên Discord Webhook -->
    <appender name="DISCORD" class="com.storex.payment.appender.DiscordAppender">
        <webhookUrl>${DISCORD_WEBHOOK_URL:-http://localhost:8080/mock/discord-webhook}</webhookUrl>
        <enabled>true</enabled>
        <username>StoreX Alert Bot</username>
        <avatarUrl>https://cdn-icons-png.flaticon.com/512/564/564619.png</avatarUrl>
    </appender>

    <!-- Cấu hình Logger cho package nghiệp vụ com.storex -->
    <logger name="com.storex" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="DISCORD"/>
    </logger>

    <!-- Logger cho Spring Boot Framework -->
    <logger name="org.springframework" level="INFO"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="DISCORD"/>
    </root>

</configuration>
